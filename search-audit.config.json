      "path": ".well-known/aiposture",
      "contentTypes": [
        "text/plain",
        "application/octet-stream"
      ],
      "contains": []
    },
    {
      "path": ".well-known/assistant-guide-manifest.txt",
      "contentTypes": [
        "text/plain"
      ],
      "contains": []
    },
    {
      "path": ".well-known/assistant-guide.txt",
      "contentTypes": [
        "text/plain"
      ],
      "contains": []
    }
  ],
  "redirects": [
    {
      "from": "http://agentlink.run/",
      "to": "https://agentlink.run/"
    },
    {
      "from": "https://www.agentlink.run/",
      "to": "https://agentlink.run/"
    },
    {
      "from": "http://www.agentlink.run/",
      "to": "https://agentlink.run/"
