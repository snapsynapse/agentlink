{
  "$schema": "portfolio-search-indexing-audit/v4",
  "contractVersion": 4,
  "canonicalOrigin": "https://agentlink.run/",
  "outputDir": "docs",
  "sitemaps": [
    "sitemap.xml"
  ],
  "minimumWords": 120,
  "thinPageExemptions": [],
  "expectedNoindex": [
    "/404.html"
  ],
  "requireJsonLd": false,
  "jsonLdRequiredPaths": [
    "/",
    "/guides/agents-md-symlinks/",
    "/guides/claude-md-and-agents-md/",
    "/guides/monorepo-instruction-files/",
    "/reference/supported-tools/"
  ],
  "lastmodAgreementPaths": [
    "/",
    "/guides/agents-md-symlinks/",
    "/guides/claude-md-and-agents-md/",
    "/guides/monorepo-instruction-files/",
    "/reference/supported-tools/"
  ],
  "compareRepositorySitemaps": true,
  "internalSourceRules": [
    {
      "pathPattern": "^/(guides|reference)/",
      "minimum": 2
    }
  ],
  "requiredFiles": [
    {
      "path": "robots.txt",
      "contentTypes": [
        "text/plain"
      ],
      "contains": [
        "User-agent: GPTBot",
        "User-agent: ClaudeBot",
        "User-agent: PerplexityBot",
        "User-agent: Google-Extended",
        "Sitemap: https://agentlink.run/sitemap.xml"
      ]
    },
    {
      "path": "sitemap.xml",
      "contentTypes": [
        "xml"
      ],
      "contains": []
    },
    {
      "path": "favicon.svg",
      "contentTypes": [
        "image/svg+xml",
        "svg"
      ],
      "contains": []
    },
    {
      "path": "assets/docs.css",
      "contentTypes": [
        "text/css"
      ],
      "contains": []
    },
    {
      "path": "imgs/og.png",
      "contentTypes": [
        "image/png"
      ],
      "contains": []
    },
    {
      "path": "imgs/instruction-file-map.svg",
      "contentTypes": [
        "image/svg+xml",
        "svg"
      ],
      "contains": []
    },
    {
      "path": "llms.txt",
      "contentTypes": [
        "text/plain"
      ],
      "contains": [
        "https://agentlink.run/guides/agents-md-symlinks/",
        "https://agentlink.run/reference/supported-tools/"
      ]
    },
    {
      "path": "site.webmanifest",
      "contentTypes": [
        "application/manifest+json",
        "application/json"
      ],
      "contains": []
