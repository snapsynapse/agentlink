{
  "schema_version": "1.0",
  "repository": "snapsynapse/agentlink",
  "profile": [
    "public-repository",
    "go-cli",
    "github-pages",
    "agent-facing",
    "release-distributed"
  ],
  "visibility": "public",
  "default_branch": "main",
  "delete_branch_on_merge": true,
  "merge_methods": {
    "merge_commit": false,
    "squash": true,
    "rebase": false,
    "auto_merge": true
  },
  "features": {
    "issues": true,
    "discussions": false,
    "wiki": false,
    "projects": false
  },
  "security": {
    "advanced_security": null,
    "secret_scanning": true,
    "secret_scanning_push_protection": true,
    "dependabot_alerts": true,
    "dependabot_security_updates": true
  },
  "actions": {
    "enabled": true,
    "allowed_actions": "all",
    "sha_pinning_required": false,
    "default_workflow_permissions": "read",
    "can_approve_pull_request_reviews": false
  },
  "pages": {
    "build_type": "legacy",
    "branch": "main",
    "path": "/docs",
    "cname": "agentlink.run",
    "https_enforced": true
  },
  "rulesets": [
    {
      "name": "Protect main",
      "target": "branch",
      "enforcement": "active",
      "include": ["refs/heads/main"],
      "rules": ["deletion", "non_fast_forward"]
    }
  ],
  "environments": [
    {
      "name": "github-pages",
      "deployment_branch": "main"
    }
  ],
  "custom_properties": {},
  "exceptions": [
    {
      "field": "actions.sha_pinning_required",
      "reason": "The user-owned repository API does not expose an enforceable repository-level SHA-pinning policy; workflows pin third-party actions in source.",
      "date": "2026-08-20"
    },
    {
      "field": "custom_properties",
      "reason": "Organization custom properties are unsupported for this user-owned repository.",
      "date": "2026-08-20"
    }
  ]
}
